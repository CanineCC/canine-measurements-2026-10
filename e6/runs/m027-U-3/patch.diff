+    private static Span NestMethodBody(Lexed f, int nameAt, int classBodyOpen)
+    {
+        var t = f.T;
+        var paramsClose = f.M[nameAt + 1];
+        var body = Enumerable.Range(paramsClose + 1, Math.Max(0, f.M[classBodyOpen] - paramsClose - 1))
+            .FirstOrDefault(x => t[x].IsPunct("{"));
+        return body > 0 && f.M[body] > 0 ? new Span(body, f.M[body] + 1) : new Span(nameAt, nameAt + 1);
+    }
+
+    private static Decision NestDecision(bool guarded, bool isPublic, bool global) =>
+        guarded ? Decision.Guarded
+        : isPublic && global ? Decision.Anonymous
+        : global ? Decision.Guarded
+        : Decision.None;
