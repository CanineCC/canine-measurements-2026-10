+    /// <summary>The unused grants of one job's own <c>permissions:</c> block; a job without one is recorded in
+    /// <paramref name="inheriting"/> instead.</summary>
+    private static List<UnusedScopeGrant> UnusedJobOwnGrants(string file, string name,
+        List<(int Index, string Line)> body, List<(string Name, bool Opaque, HashSet<string> Used)> inheriting)
+    {
+        var unused = new List<UnusedScopeGrant>();
+        if (body.Count == 0) { return unused; }
+        var keyIndent = body.Where(l => l.Line.Trim().Length > 0).Min(l => LeadingSpaces(l.Line));
+        var own = body.FirstOrDefault(l => LeadingSpaces(l.Line) == keyIndent && PermissionsBlock.IsMatch(l.Line));
+        var (opaque, used) = JobTokenUse(body);
+        if (own.Line is null)
+        {
+            inheriting.Add((name, opaque, used));
+            return unused;
+        }
+
+        if (opaque) { return unused; }
+        unused.AddRange(JudgedWriteGrants(body, own)
+            .Where(g => !used.Contains(g.Scope))
+            .Select(g => new UnusedScopeGrant(file, g.Line, g.Scope, $"job `{name}`")));
+        return unused;
+    }
