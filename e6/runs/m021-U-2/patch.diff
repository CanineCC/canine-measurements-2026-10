+    /// <summary>Shard matrices: group the expansions of one written command and compare the shard indices with the total.
+    /// Returns the (file, line) of every command whose matrix misses a shard.</summary>
+    private static HashSet<(string, int)> PartialShardMatrices(
+        List<(TestInvocation Inv, JsInventory.Selection Sel)> sel, List<Site> sites)
+    {
+        var partial = new HashSet<(string, int)>();
+        foreach (var g in sel.Where(s => s.Sel.Shard is not null && s.Inv.Site.Template.Contains("${{", StringComparison.Ordinal))
+                     .GroupBy(s => (s.Inv.Site.File, s.Inv.Site.Line, s.Inv.Runner)))
+        {
+            foreach (var byTotal in g.GroupBy(s => s.Sel.Shard!.Value.Total))
+            {
+                if (!int.TryParse(byTotal.Key, NumberStyles.Integer, CultureInfo.InvariantCulture, out var total) || total < 2)
+                {
+                    continue;
+                }
+
+                var indices = byTotal.Select(s => int.TryParse(s.Sel.Shard!.Value.Index, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : -1).ToHashSet();
+                if (indices.Contains(-1))
+                {
+                    continue;
+                }
+
+                var missing = Enumerable.Range(1, total).Where(n => !indices.Contains(n)).ToList();
+                if (missing.Count > 0)
+                {
+                    partial.Add((g.Key.File, g.Key.Line));
+                    sites.Add(new Site(g.Key.File, g.Key.Line, "Test shard matrix runs only some shards",
+                        $"`{Short(g.First().Inv.Site.Template)}` splits the suite into {total} shards, but the matrix runs only "
+                        + $"{string.Join(", ", indices.Order())} — shard(s) {string.Join(", ", missing)} never run, so their tests "
+                        + "gate nothing. List every shard index in the matrix."));
+                }
+            }
+        }
+
+        return partial;
+    }
+
+    /// <summary>A narrowing path that selects no test file, made green by --passWithNoTests.</summary>
+    private static void PassWithNoTestsSites(JsInventory.Inventory inv,
+        List<(TestInvocation Inv, JsInventory.Selection Sel)> sel, List<Site> sites)
+    {
+        foreach (var (i, s) in sel.Where(x => x.Sel.PassWithNoTests && x.Sel.Paths.Count > 0 && x.Sel.Certain && x.Inv.Site.Gates))
+        {
+            var any = inv.Units.Any(u => (i.Root.Length == 0 || u.File.StartsWith(i.Root + "/", StringComparison.Ordinal))
+                                         && inv.PackageOf(u.File) is { } p && JsInventory.Collects(p, i.Runner, u.File, s.OverridesConfigExclusions).Collects
+                                         && JsInventory.PathSelected(i, s, u.File));
+            if (!any)
+            {
+                sites.Add(new Site(i.Site.File, i.Site.Line, "Test selection matches no test, and passes anyway",
+                    $"`{Short(i.Site.Template)}` selects `{string.Join(" ", s.Paths)}`, which matches no test file, and "
+                    + "`--passWithNoTests` turns the empty run into a pass — the step is green while running nothing. Point it "
+                    + "at the tests it is meant to run, or drop the flag."));
+            }
+        }
+    }
