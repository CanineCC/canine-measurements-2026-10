+    /// <summary>Parses <c>export [default] [async] function|const|let name</c> at <paramref name="i"/>; returns the
+    /// exported name, the index of the declaring keyword, and whether it is the default export (null when not a declaration).</summary>
+    private static (string Name, int Keyword, bool IsDefault)? ReadNextExport(IReadOnlyList<JsToken> t, int i)
+    {
+        var k = i + 1;
+        var isDefault = t[k].IsWord("default");
+        if (isDefault)
+        {
+            k++;
+        }
+
+        if (k < t.Count && t[k].IsWord("async"))
+        {
+            k++;
+        }
+
+        if (k + 1 >= t.Count)
+        {
+            return null;
+        }
+
+        if (t[k].IsWord("function"))
+        {
+            return (t[k + 1].IsName ? t[k + 1].Text : "default", k, isDefault);
+        }
+
+        if ((t[k].IsWord("const") || t[k].IsWord("let")) && t[k + 1].IsName)
+        {
+            return (t[k + 1].Text, k, isDefault);
+        }
+
+        return null;
+    }
