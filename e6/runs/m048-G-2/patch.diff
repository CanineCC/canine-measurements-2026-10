+            // A ship that judged nothing is a broken gate step: the turn exits 4 and `run` stops.
+            Say($"  SHIP UNJUDGED — {unjudged}. No package is blamed: {result.Merged.Count} held (not parked, no attempt "
+                + "counted, no backlog write) and nothing landed. Clear the cause before the next turn.");
+        }
+        else if (ship.MainMoved is { } moved)
+        {
+            // Until 2026-10-17 exit 3 parked every merged package, an attempt each. Main moving under the turn says
+            // nothing about them: back to the queue, re-planned against the new main. Not a broken gate — `run`
+            // goes on, and its next turn starts from the new main.
+            Say($"  SHIP REQUEUED — {moved}. No package is blamed: {result.Merged.Count} back in the queue (not parked, "
+                + "no attempt counted, no backlog write) and nothing landed; the next turn re-plans them against the new main.");
+        }
+
+        return new ShipOutcome(landed, ship.ExitCode, ship.Unjudged, ship.Unjudged is null ? ship.MainMoved : null);
+    }
+
+    private async Task<ShipResult> ShipWithRetryAsync(string worktree, string provedSha, CancellationToken ct)
+    {
+        var ship = await ports.Shipper!.ShipAsync(worktree, provedSha, ct).ConfigureAwait(false);
+        if (ship.ExitCode == 1 && ship.Unjudged is null && ship.MainMoved is null)
+        {
+            // ★ The turn gate proved this set green, the full Unit suite included. 2026-10-19 (t0019): ship.sh's
+            //   re-run of that suite on the rebased tree met a test that flakes under load (it passed alone on
+            //   the base, so ship.sh called it the change's own) and four proven packages were parked, an
+            //   attempt each. A red that does not repeat says nothing about them: ship once more before any
+            //   package is blamed. A red that repeats is judged as before.
+            Say("  ship.sh exit 1 on a set the turn gate proved — shipping once more before any package is blamed");
+            ship = await ports.Shipper.ShipAsync(worktree, provedSha, ct).ConfigureAwait(false);
+        }
+
+        return ship;
+    }
+
+    private static List<(ShellVerdict, string)> BuildParked(IReadOnlyList<ShellVerdict> verdicts, TurnGateResult result,
+        ShipOutcome ship, string? wouldLand)
+    {
+        var parked = new List<(ShellVerdict, string)>();
+        foreach (var v in verdicts.Where(v => v.Outcome != ShellOutcome.Passed))
+        {
+            parked.Add((v, $"{v.Outcome}: {v.Reason}"));
+        }
+
+        // ★ A branch that did not MERGE after the others is a collision of two passing packages, not a verdict on it.
+        //   2026-10-19, t0021: domain-depends-on-infrastructure/csharp passed its own gate, conflicted with the two
+        //   merged before it in the shared PROGRESS and ledger files, and was parked with an attempt counted — two
+        //   such turns would retire a correct package. It goes back to the queue unjudged; its next brief points at
+        //   this branch (PreviousAttempt), so the next shell merges it onto a main that has the others' rows.
+        parked.AddRange(result.Dropped.Where(d => !d.MergeConflict).Select(d => (d.Shell, $"dropped by the turn gate: {d.Reason}")));
+        if (wouldLand is null && ship.Unjudged is null && ship.Requeued is null)
+        {
+            var why = ship.ShipExit is { } rc ? $"ship.sh exit {rc}, nothing landed" : "the turn gate passed nothing";
+            parked.AddRange(result.Merged.Select(m => (m, why)));
+        }
+
+        return parked;
+    }
+
+    private IReadOnlyList<OwedWrite> PlanWrites(IBacklog backlog, IReadOnlyList<Package> queue, IReadOnlyList<ShellVerdict> shipped,
+        IReadOnlyList<(ShellVerdict Shell, string Reason)> parked, string? wouldLand, string turnId, TurnGateResult result)
+    {
+        var shippedKeys = shipped.Select(s => s.Package.Key).ToHashSet();
+        // Shipped by ANY instance: an item two packages share closes once both have shipped, wherever they ran.
+        var shared = ports.State.LoadShared();
+        return new Closer(backlog, options.WorkerId, options.Host).Plan(shipped, parked, wouldLand, turnId, result.FullDelta,
+            Sharers(queue), k => shippedKeys.Contains(k) || shared.Packages.TryGetValue(k.Slug, out var h) && h.ShippedSha is not null);
+    }
+
+    // State: shipped packages are done; a parked one counts an attempt unless the instrument, a usage limit or
+    // a dry run is why (none of those is the package's fault). ★ Saved BEFORE the first backlog write, with every
+    // write still owed: what landed on main is on record whatever happens to the close-out (2026-10-17: a
+    // connection reset after the push would otherwise have lost both).
+    private void RecordState(OrchestratorState state, string turnId, int turnNumber, IReadOnlyList<ShellVerdict> shipped,
+        ShipOutcome ship, TurnGateResult result, IReadOnlyList<ShellVerdict> held, string heldWhy,
+        IReadOnlyList<Dropped> conflicted, IReadOnlyList<(ShellVerdict Shell, string Reason)> parked, UsageLimit limit,
+        IReadOnlyList<OwedWrite> planned)
+    {
+        foreach (var s in shipped)
+        {
+            var h = state.Of(s.Package.Key);
+            h.ShippedSha = ship.Landed;
+            h.LastOutcome = $"shipped in {turnId}";
+            h.WorkedItems = [.. h.WorkedItems.Union(s.Package.Items.Select(i => i.Id), StringComparer.Ordinal)];
+        }
+
+        foreach (var v in held)
+        {
+            Park(state, v, $"{turnId}: held, unjudged — {heldWhy}");
+        }
+
+        foreach (var d in conflicted)
+        {
+            Park(state, d.Shell, $"{turnId}: requeued, unjudged — {d.Reason}");
+        }
+
+        foreach (var m in ship.Requeued is null ? [] : result.Merged)
+        {
+            Park(state, m, $"{turnId}: requeued, unjudged — {ship.Requeued}");
+        }
+
+        foreach (var (v, why) in parked)
+        {
+            if (v.Outcome != ShellOutcome.Instrument && !(v.Outcome == ShellOutcome.Unfinished && limit != UsageLimit.None))
+            {
+                state.Of(v.Package.Key).FailedAttempts++;
+            }
+
+            Park(state, v, $"{turnId}: {why}");
+        }
+
+        state.Turns = Math.Max(state.Turns, turnNumber);
+        state.LastLimit = limit;
+        state.OwedWrites.AddRange(planned);
+        ports.State.Save(state);
+    }
+
+    private void Park(OrchestratorState state, ShellVerdict v, string outcome)
+    {
+        var h = state.Of(v.Package.Key);
+        h.LastOutcome = outcome;
+        h.ParkedBranch = $"{options.Host}:{v.Branch}@{v.Head ?? "no commit"}";
+    }
+
+    private async Task<CloseOutcome> CloseOutAsync(IBacklog backlog, OrchestratorState state, IReadOnlyList<OwedWrite> planned,
+        string turnId, string? landed, CancellationToken ct)
+    {
+        if (backlog is RecordingBacklog rec)
+        {
+            await CloseOut.ExecuteAsync(rec, planned.ToList(), [], () => { }, log, ct).ConfigureAwait(false);
+            return new CloseOutcome(rec.Writes, null, null);
+        }
+
+        var refusedBefore = state.RefusedWrites.Count;
+        var close = await CloseOut.ExecuteAsync(backlog, state.OwedWrites, state.RefusedWrites, () => ports.State.Save(state), log, ct)
+            .ConfigureAwait(false);
+        var owedLeft = state.OwedWrites.Where(o => o.TurnId == turnId).Select(CloseOut.Describe).ToList();
+        var refusedNow = state.RefusedWrites.Skip(refusedBefore).Select(r => $"{CloseOut.Describe(r.Write)} — {r.Error}").ToList();
+        if (owedLeft.Count + refusedNow.Count > 0)
+        {
+            SayIncomplete(landed, close.Written.Count, owedLeft, refusedNow);
+        }
+
+        return new CloseOutcome(close.Written, owedLeft, refusedNow);
+    }
+
+    private void SayIncomplete(string? landed, int written, List<string> owedLeft, List<string> refusedNow)
+    {
+        Say($"  close-out INCOMPLETE — {(landed is null ? "nothing landed" : $"landed {landed} (state.json says shipped)")}; "
+            + $"{written} write(s) made, {owedLeft.Count} OWED (state.json OwedWrites; the next live turn replays them first), "
+            + $"{refusedNow.Count} REFUSED (state.json RefusedWrites; a person must read them)");
+        foreach (var line in owedLeft)
+        {
+            Say("    owed: " + line);
+        }
+
+        foreach (var line in refusedNow)
+        {
+            Say("    refused: " + line);
+        }
+    }
+
+    private static ShellSummary Summarize(ShellVerdict v) =>
+        new(v.Package.Key.ToString(), v.Branch, v.Head, v.Outcome.ToString(), v.Reason,
+            v.Figure, v.Delta?.Gains ?? [], v.Delta?.Regressions ?? [],
+            v.Items.Select(i => $"{i.Item.Id} {(i.Covered ? "COVERED" : "open")}: {i.Reason}").ToList());
+
     private IReadOnlyList<string> Related(Package p) =>
         p.Dimensions.Concat(ports.Index.DimensionsOf(p.Key.Concept)).Distinct(StringComparer.Ordinal)
             .Order(StringComparer.Ordinal).ToList();
