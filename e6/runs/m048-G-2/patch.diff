+    private async Task AwaitRelayAsync(Task shellsDone)
+    {
+        try
+        {
+            await shellsDone.ConfigureAwait(false);
+        }
+        catch (Exception e) when (e is not OperationCanceledException)
+        {
+            Say($"  relay: {e.Message}");
+        }
+    }
