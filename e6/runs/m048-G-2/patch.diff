+    private async Task<TurnGateResult> RunTurnGateAsync(IReadOnlyList<ShellVerdict> verdicts, string? baseArm, BenchArm arm,
+        TurnWorkspace workspace, CancellationToken ct)
+    {
+        var passing = verdicts.Where(v => v.Outcome == ShellOutcome.Passed).ToList();
+        var turnGate = new TurnGate(ports.Git, ports.Gates, workspace, ports.Index, ports.Corpus);
+        var result = passing.Count == 0 || baseArm is null
+            ? new TurnGateResult(null, null, [], [], null, ["no branch passed its own gate"])
+            : await turnGate.RunAsync(arm, passing, v => Related(v.Package).ToHashSet(StringComparer.Ordinal), ct)
+                .ConfigureAwait(false);
+        foreach (var line in result.Log)
+        {
+            Say("  gate: " + line);
+        }
+
+        return result;
+    }
