+    private static bool IsUnder(string path, string root) =>
+        path.StartsWith(root, StringComparison.Ordinal) || path.Contains("/" + root, StringComparison.Ordinal);
+
+    /// <summary>Parses <c>export [default] [async] function|const|let name</c> at <paramref name="i"/>; returns the index
+    /// of the declaration keyword, whether it is a default export, and the exported name (null when not a declaration).</summary>
+    private static (int Keyword, bool IsDefault, string? Name) ParseNextExport(IReadOnlyList<JsToken> t, int i)
+    {
+        var k = i + 1;
+        var isDefault = t[k].IsWord("default");
+        if (isDefault)
+        {
+            k++;
+        }
+
+        if (k < t.Count && t[k].IsWord("async"))
+        {
+            k++;
+        }
+
+        string? name = null;
+        if (k + 1 < t.Count && t[k].IsWord("function"))
+        {
+            name = t[k + 1].IsName ? t[k + 1].Text : "default";
+        }
+        else if (k + 1 < t.Count && (t[k].IsWord("const") || t[k].IsWord("let")) && t[k + 1].IsName)
+        {
+            name = t[k + 1].Text;
+        }
+
+        return (k, isDefault, name);
+    }
