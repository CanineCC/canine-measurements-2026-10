+    private async Task<TurnCheck?> CheckMergedPinAsync(IReadOnlyList<ShellVerdict> merged, string? basePin, string headPin, CancellationToken ct)
+    {
+        foreach (var m in merged.Where(m => m.CorpusPin is not null && m.CorpusPin != basePin))
+        {
+            if (!await _corpus.ContainsAsync(headPin, m.CorpusPin!, ct).ConfigureAwait(false))
+            {
+                return new TurnCheck(TurnStage.Bench, $"the merged corpus pin {headPin[..Math.Min(10, headPin.Length)]} does not contain "
+                    + $"{m.Package.Key}'s pin {m.CorpusPin![..Math.Min(10, m.CorpusPin!.Length)]}: the merge lost a bench entry "
+                    + "(tools/bench/merge_pins.py takes the pin that contains the other)", null, Broken: true);
+            }
+        }
+
+        return null;
+    }
+
+    /// <summary>Runs the prelock and guards stages the request covers; a failure, or the verdict of a run that stops
+    /// short of the bench stage, is returned, null means the bench stage runs next.</summary>
+    private async Task<TurnCheck?> RunCheapStagesAsync(string wt, string name, TurnStage? only, CancellationToken ct)
+    {
+        var all = only is null;
+        if (all || only == TurnStage.Prelock)
+        {
+            var log = workspace.FileFor(name, "prelock.log");
+            var step = await gates.RunPrelockAsync(wt, log, ct).ConfigureAwait(false);
+            if (step != StepOutcome.Green)
+            {
+                return StepCheck(TurnStage.Prelock, step, "pre-lock suites", log);
+            }
+        }
+
+        if (all || only == TurnStage.Guards)
+        {
+            var log = workspace.FileFor(name, "guards.log");
+            var step = await gates.RunGuardsAsync(wt, log, ct).ConfigureAwait(false);
+            if (step != StepOutcome.Green)
+            {
+                return StepCheck(TurnStage.Guards, step, "guards", log);
+            }
+        }
+
+        return !all && only != TurnStage.Bench ? new TurnCheck(TurnStage.None, "", null) : null;
+    }
+
+    private async Task<(BenchArm? Arm, TurnCheck? Failure)> BaseAtPinAsync(string name, BenchArm baseArm, string headPin,
+        List<string> gateLog, CancellationToken ct)
+    {
+        if (_baseAtPin.TryGetValue(headPin, out var cached))
+        {
+            return (cached, null);
+        }
+
+        var shortPin = headPin[..Math.Min(10, headPin.Length)];
+        var path = workspace.FileFor(name, $"bench-base-at-{shortPin}.json");
+        var scored = await gates.BenchAtPinAsync(baseArm.Worktree, baseArm.Label, null, headPin, path, ct).ConfigureAwait(false);
+        if (scored is null)
+        {
+            return (null, new TurnCheck(TurnStage.Bench, $"the base arm could not be measured at corpus {shortPin}", null, Broken: true));
+        }
+
+        var atPin = new BenchArm(baseArm.Worktree, baseArm.Label, null, scored, headPin);
+        _baseAtPin[headPin] = atPin;
+        gateLog.Add($"  bench {name}: base arm scored at the merged corpus pin {shortPin}");
+        return (atPin, null);
+    }
