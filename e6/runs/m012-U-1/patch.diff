+    private static bool IsOpeningBracket(JsToken tok) => tok.IsPunct("(") || tok.IsPunct("{") || tok.IsPunct("[");
+
+    private static bool IsClosingBracket(JsToken tok) => tok.IsPunct(")") || tok.IsPunct("}") || tok.IsPunct("]");
+
+    /// <summary>Whether the identifier at <paramref name="k"/> refers to a binding, rather than being a member access
+    /// (<c>a.name</c>) or an object-literal key (<c>{ name: ... }</c>).</summary>
+    private static bool IsBindingReference(IReadOnlyList<JsToken> t, int k)
+    {
+        if (k == 0)
+        {
+            return true;
+        }
+
+        if (t[k - 1].IsMemberAccessor)
+        {
+            return false;
+        }
+
+        var isObjectKey = k + 1 < t.Count && t[k + 1].IsPunct(":") && (t[k - 1].IsPunct("{") || t[k - 1].IsPunct(","));
+        return !isObjectKey;
+    }
+
