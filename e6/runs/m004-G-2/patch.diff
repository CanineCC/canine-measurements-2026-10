+    {
+        if (SplitNameAndParenthesis(entry) is { Parenthesis: { } version } resolvedPod && !version.Contains(' '))
+        {
+            resolved.TryAdd(resolvedPod.Name.Split('/')[0], version);
+        }
+    }
