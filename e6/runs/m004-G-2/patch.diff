+    /// <summary>The text of a two-space-indented <c>- </c> list entry, or null for any other line. PODS lists a pod at
+    /// two-space indent and its own requirements at four; only the first is a resolution.</summary>
+    private static string? TryReadTopLevelEntry(string line)
+    {
+        var indent = line.Length - line.TrimStart().Length;
+        var entry = line.Trim();
+        if (indent != 2 || !entry.StartsWith("- ", StringComparison.Ordinal))
+        {
+            return null;
+        }
+
+        return entry[2..].Trim().TrimEnd(':').Trim('"', '\'');
+    }
+
