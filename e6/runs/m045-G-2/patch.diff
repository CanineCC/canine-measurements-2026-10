+    private static string Abbrev(string s) => s[..Math.Min(10, s.Length)];
+
+    // ★ The merged corpus pin must hold every merged branch's bench entry. tools/bench/merge_pins.py merges two moved
+    //   pins to the one that contains the other (the corpus's main is linear); anything else is refused here, before
+    //   any stage runs: a turn that pinned a corpus without a shell's entry would measure that shell's item on nothing.
+    private async Task<TurnCheck?> CheckMergedPinAsync(IReadOnlyList<ShellVerdict> merged, string? basePin, string headPin, CancellationToken ct)
+    {
+        foreach (var m in merged.Where(m => m.CorpusPin is not null && m.CorpusPin != basePin))
+        {
+            if (!await _corpus.ContainsAsync(headPin, m.CorpusPin!, ct).ConfigureAwait(false))
+            {
+                return new TurnCheck(TurnStage.Bench, $"the merged corpus pin {Abbrev(headPin)} does not contain "
+                    + $"{m.Package.Key}'s pin {Abbrev(m.CorpusPin!)}: the merge lost a bench entry "
+                    + "(tools/bench/merge_pins.py takes the pin that contains the other)", null, Broken: true);
+            }
+        }
+
+        return null;
+    }
+
+    /// <summary>The prelock and guards stages, when selected; the first red one's check, or null when none is red.</summary>
+    private async Task<TurnCheck?> RunCheapStagesAsync(string wt, string name, TurnStage? only, CancellationToken ct)
+    {
+        if (only is null || only == TurnStage.Prelock)
+        {
+            var log = workspace.FileFor(name, "prelock.log");
+            var step = await gates.RunPrelockAsync(wt, log, ct).ConfigureAwait(false);
+            if (step != StepOutcome.Green)
+            {
+                return StepCheck(TurnStage.Prelock, step, "pre-lock suites", log);
+            }
+        }
+
+        if (only is null || only == TurnStage.Guards)
+        {
+            var log = workspace.FileFor(name, "guards.log");
+            var step = await gates.RunGuardsAsync(wt, log, ct).ConfigureAwait(false);
+            if (step != StepOutcome.Green)
+            {
+                return StepCheck(TurnStage.Guards, step, "guards", log);
+            }
+        }
+
+        return null;
+    }
+
+    // The base arm at the merged head's corpus pin: the base engine on the units the branches' entries added, every
+    // unit scored on the one corpus commit the head reads (BENCH_CORPUS_PIN). Null when it could not be measured.
+    private async Task<BenchArm?> BaseAtPinAsync(string wt, string name, BenchArm baseArm, string headPin, List<string> gateLog, CancellationToken ct)
+    {
+        if (_baseAtPin.TryGetValue(headPin, out var cached))
+        {
+            return cached;
+        }
+
+        var path = workspace.FileFor(name, $"bench-base-at-{Abbrev(headPin)}.json");
+        var scored = await gates.BenchAtPinAsync(baseArm.Worktree, baseArm.Label, null, headPin, path, ct).ConfigureAwait(false);
+        if (scored is null)
+        {
+            return null;
+        }
+
+        var atPin = new BenchArm(baseArm.Worktree, baseArm.Label, null, scored, headPin);
+        _baseAtPin[headPin] = atPin;
+        gateLog.Add($"  bench {name}: base arm scored at the merged corpus pin {Abbrev(headPin)}");
+        return atPin;
+    }
+
+    private async Task<TurnCheck> JudgeSideMovesAsync(string wt, string name, IReadOnlyList<ShellVerdict> merged,
+        Func<ShellVerdict, IReadOnlySet<string>> related, BenchDelta delta, List<string> gateLog, CancellationToken ct)
+    {
         var turnDims = merged.SelectMany(related).ToHashSet(StringComparer.Ordinal);
         var side = await SideMoves.JudgeAsync(gates, index, wt, BenchLines.Of(delta), turnDims,
             Path.GetDirectoryName(workspace.FileFor(name, "bench-delta.json")) ?? wt, ct).ConfigureAwait(false);
