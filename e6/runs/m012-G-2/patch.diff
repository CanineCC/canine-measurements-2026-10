+    /// <summary>The last token index of the skip range covering <paramref name="k"/>, or -1 when none does.</summary>
+    private static int SkipEnd(List<(int From, int To)> skip, ref int s, int k)
+    {
+        while (s < skip.Count && skip[s].To < k)
+        {
+            s++;
+        }
+
+        return s < skip.Count && skip[s].From <= k ? skip[s].To : -1;
+    }
+
+    private static int BracketDelta(JsToken tok)
+    {
+        if (tok.IsPunct("(") || tok.IsPunct("{") || tok.IsPunct("["))
+        {
+            return 1;
+        }
+
+        return tok.IsPunct(")") || tok.IsPunct("}") || tok.IsPunct("]") ? -1 : 0;
+    }
+
+    private static bool IsForeignReference(IReadOnlyList<JsToken> t, int k, Dictionary<string, Foreign> foreign, out Foreign from)
+    {
+        var tok = t[k];
+        from = default!;
+        if (!tok.IsAnyIdentifier || !foreign.TryGetValue(tok.Text, out var found))
+        {
+            return false;
+        }
+
+        from = found;
+        if (k == 0)
+        {
+            return true;
+        }
+
+        if (t[k - 1].IsMemberAccessor)
+        {
+            return false;
+        }
+
+        var objectKey = k + 1 < t.Count && t[k + 1].IsPunct(":") && (t[k - 1].IsPunct("{") || t[k - 1].IsPunct(","));
+        return !objectKey;
+    }
