+    /// <summary>The base arm scored at <paramref name="pin"/>, cached per pin; null when it could not be measured.</summary>
+    private async Task<BenchArm?> BaseArmAtPinAsync(string name, BenchArm baseArm, string pin, List<string> gateLog, CancellationToken ct)
+    {
+        if (_baseAtPin.TryGetValue(pin, out var atPin))
+        {
+            return atPin;
+        }
+
+        var path = workspace.FileFor(name, $"bench-base-at-{ShortPin(pin)}.json");
+        var scored = await gates.BenchAtPinAsync(baseArm.Worktree, baseArm.Label, null, pin, path, ct).ConfigureAwait(false);
