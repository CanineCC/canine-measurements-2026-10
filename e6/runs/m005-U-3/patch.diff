+    /// <summary>The literal bound to the name by <paramref name="tail"/>, or null: a setting-key argument reads the next
+    /// argument, a bare `??`/`||` reads the fallback, and any other operator reads the value after it.</summary>
+    private static string? BoundLiteralValue(string line, Match name, Match tail, bool unquotedConfig)
+    {
+        var at = tail.Index + tail.Length;
+        if (tail.Groups["arg"].Success)
+        {
+            return QuotedLiteralAt(line, at) ?? EncodedLiteralAt(line, at);
+        }
+
+        if (tail.Groups["fb"].Success)
+        {
+            return FallbackLiteralAfter(line, at);
+        }
+
+        return QuotedLiteralAt(line, at)
+               ?? EncodedLiteralAt(line, at)
+               ?? (unquotedConfig ? UnquotedConfigValue(line, name.Index + name.Length) : null)
+               ?? FallbackLiteralAfter(line, at);
+    }
+
+    /// <summary>The signing-key rule's whole value gate, so the two name-driven key rules answer alike: a key's shape, and
+    /// not the key's own name, a secret's address, a row of an identifier table or a guarded empty-default.</summary>
+    private static bool IsRejectedKeyValue(string[] lines, int i, string name, string trimmed) =>
+        !IsSigningKeyValue(trimmed)
+        || ScreamingSnakeName.IsMatch(trimmed)
+        || IsKeyNameAlias(name, trimmed)
+        || BindsTheAddressOfASecret(name, trimmed)
+        || IsMemberOfIdentifierTable(lines, i, trimmed)
+        || IsGuardedEmptyFallback(lines, i, name);
+
+    /// <summary>A LOOKUP key, not key material: the name's only purpose words are the ones a dictionary key shares with a
+    /// cryptographic one (a session key, a token key, a cookie key) and the value is a name — every segment a
+    /// word (`improve-orchestrator`, `concept-first-p3-packages`) or a configuration path
+    /// (`Kennel__Providers__GitHub__PublicReadToken`). MEASURED (prod run b8dcbfc7, CanineCC/kennel.canine.dev):
+    /// 4 of D13's 7 rows were `OriginSessionKey`, `PackageSessionKey`, `TokenEnvKey` and `KEY=` under a job named
+    /// `set-token`. A name that states a cryptographic purpose (`jwt-secret`, `SigningKey`, `HmacKey`) is not
+    /// ambiguous, and keeps firing on a word-shaped value — a diceware passphrase is a key
+    /// (NativeSecretScannerTests.WordShapedPassphrase_BoundToSecretKey_IsStillFlagged).</summary>
+    private static bool IsLookupKey(List<string> words, string trimmedValue) =>
+        words[^1] == "key"
+        && words.Where(w => CryptoPurposeWords.Contains(w)).All(w => w is "session" or "token" or "cookie")
+        && IsReadableWordIdentifier(trimmedValue);
+
+    private static string ClassifyKeySecret(List<string> words)
+    {
+        switch (words[^1])
+        {
+            case "passphrase":
+                return "crypto-key-passphrase";
+            case "secret":
+                return "signing-key";
+        }
+
+        return words.Any(w => w is "jwt" or "jws" or "signing" or "sign" or "signature" or "hmac" or "mac"
+                              or "token" or "session" or "cookie" or "webhook")
+            ? "signing-key"
+            : "hardcoded-crypto-key";
+    }
+
     /// <summary>The unquoted value of a <c>NAME=value</c> / <c>NAME: value</c> line of an unquoted config file, read
     /// from the first <c>=</c>/<c>:</c> after the name. Read directly rather than through the binding tail: a base64
     /// value ends in <c>=</c>, which the tail's typed-declaration arm (<c>name: T = …</c>) would otherwise claim.</summary>
