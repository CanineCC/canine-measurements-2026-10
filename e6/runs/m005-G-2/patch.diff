+    /// <summary>The purpose may be the name's own (<c>JWT_SECRET</c>) or its config section's (<c>"Jwt": { "Key": … }</c>).</summary>
+    private static void AddSectionPurposeWords(string file, string[] lines, int i, List<string> words)
+    {
+        if (!words.Any(w => CryptoPurposeWords.Contains(w)))
+        {
+            words.InsertRange(0, SplitWords(EnclosingSection(file, lines, i) ?? "").ConvertAll(w => w.ToLowerInvariant()));
+        }
+    }
 
-            return words[^1] switch
