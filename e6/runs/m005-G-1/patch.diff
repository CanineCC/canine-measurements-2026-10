+    /// <summary>The literal bound to <paramref name="name"/> on the line, or null when the name is not followed by a binding.</summary>
+    private static string? CryptoKeyBoundValue(string line, Match name, bool unquotedConfig)
+    {
+        var tail = CryptoKeyBindingTail.Match(line, name.Index + name.Length);
+        if (!tail.Success)
+        {
+            return null;
         }
 
-        return null;
+        var at = tail.Index + tail.Length;
+        if (tail.Groups["arg"].Success)
+        {
+            return name.Index == 0 || line[name.Index - 1] != line[tail.Index]
+                ? null
+                : QuotedLiteralAt(line, at) ?? EncodedLiteralAt(line, at);
+        }
+
+        return tail.Groups["fb"].Success
+            ? FallbackLiteralAfter(line, at)
+            : QuotedLiteralAt(line, at)
+              ?? EncodedLiteralAt(line, at)
+              ?? (unquotedConfig ? UnquotedConfigValue(line, name.Index + name.Length) : null)
+              ?? FallbackLiteralAfter(line, at);
     }
 
+    // The signing-key rule's whole value gate, so the two name-driven key rules answer alike: a key's shape, and
+    // not the key's own name, a secret's address, a row of an identifier table or a guarded empty-default.
+    private static bool IsRejectedKeyValue(string[] lines, int i, string name, string value) =>
+        !IsSigningKeyValue(value)
+        || ScreamingSnakeName.IsMatch(value.Trim())
+        || IsKeyNameAlias(name, value.Trim())
+        || BindsTheAddressOfASecret(name, value.Trim())
+        || IsMemberOfIdentifierTable(lines, i, value.Trim())
+        || IsGuardedEmptyFallback(lines, i, name);
+
+    // A LOOKUP key, not key material: the name's only purpose words are the ones a dictionary key shares with a
+    // cryptographic one (a session key, a token key, a cookie key) and the value is a name — every segment a
+    // word (`improve-orchestrator`, `concept-first-p3-packages`) or a configuration path
+    // (`Kennel__Providers__GitHub__PublicReadToken`). MEASURED (prod run b8dcbfc7, CanineCC/kennel.canine.dev):
+    // 4 of D13's 7 rows were `OriginSessionKey`, `PackageSessionKey`, `TokenEnvKey` and `KEY=` under a job named
+    // `set-token`. A name that states a cryptographic purpose (`jwt-secret`, `SigningKey`, `HmacKey`) is not
+    // ambiguous, and keeps firing on a word-shaped value — a diceware passphrase is a key
+    // (NativeSecretScannerTests.WordShapedPassphrase_BoundToSecretKey_IsStillFlagged).
+    private static bool IsLookupKey(List<string> words, string value) =>
+        words[^1] == "key"
+        && words.Where(w => CryptoPurposeWords.Contains(w)).All(w => w is "session" or "token" or "cookie")
+        && IsReadableWordIdentifier(value.Trim());
