+    private static Span NestMethodBodySpan(Lexed f, int methodAt, int classBodyOpen)
+    {
+        var t = f.T;
+        var paramsClose = f.M[methodAt + 1];
+        var body = Enumerable.Range(paramsClose + 1, Math.Max(0, f.M[classBodyOpen] - paramsClose - 1))
+            .FirstOrDefault(x => t[x].IsPunct("{"));
+        return body > 0 && f.M[body] > 0 ? new Span(body, f.M[body] + 1) : new Span(methodAt, methodAt + 1);
+    }
+
+    private static Decision NestDecision(bool guarded, bool isPublic, bool globalGuard) =>
+        guarded ? Decision.Guarded
+        : isPublic && globalGuard ? Decision.Anonymous
+        : globalGuard ? Decision.Guarded
+        : Decision.None;
