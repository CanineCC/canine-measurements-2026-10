+    private static List<(ShellVerdict, string)> CollectParked(List<ShellVerdict> verdicts, TurnGateResult result, string? wouldLand,
+        bool shipHeldOrRequeued, int? shipExit)
+    {
+        var parked = new List<(ShellVerdict, string)>();
+        foreach (var v in verdicts.Where(v => v.Outcome != ShellOutcome.Passed))
+        {
+            parked.Add((v, $"{v.Outcome}: {v.Reason}"));
+        }
+
+        parked.AddRange(result.Dropped.Where(d => !d.MergeConflict).Select(d => (d.Shell, $"dropped by the turn gate: {d.Reason}")));
+        if (wouldLand is null && !shipHeldOrRequeued)
+        {
+            var why = shipExit is { } rc ? $"ship.sh exit {rc}, nothing landed" : "the turn gate passed nothing";
+            parked.AddRange(result.Merged.Select(m => (m, why)));
+        }
+
+        return parked;
+    }
