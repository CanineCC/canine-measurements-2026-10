+        /// <summary>Whether token <paramref name="k"/> is a <c>.json</c>/<c>.send</c>/<c>.end</c>/<c>.jsonp</c> call with an argument list.</summary>
+        private static bool IsPayloadCall(Lexed f, int k)
+        {
+            var t = f.T;
+            return t[k].IsName && t[k].Text is "json" or "send" or "end" or "jsonp" && k > 0 && t[k - 1].IsMemberAccessor
+                   && k + 1 < t.Count && t[k + 1].IsPunct("(") && f.M[k + 1] > 0;
+        }
+
+        /// <summary>Judges one token of a block body; false when it makes the handler more than a constant answer.</summary>
+        private static bool TokenAnswersOnlyConstants(Lexed f, Span body, string response, HashSet<string> locals, int k)
+        {
+            var t = f.T;
+            // A statement of the body itself, or of a block nested in it — never a key of an object literal.
+            var statementStart = (t[k - 1].IsPunct("{") || t[k - 1].IsPunct(";") || t[k - 1].IsPunct("}"))
+                                 && !InsideExpression(f, k, body.Start);
+            if (statementStart && !StatementStartAllowed(f, body, response, locals, k))
+            {
+                return false;
+            }
+
+            if (IsPayloadCall(f, k) && !IsConstantSpan(f, new Span(k + 2, f.M[k + 1]), locals))
+            {
+                return false;
+            }
+
+            if (t[k].IsWord("return") && k + 1 < body.End && !t[k + 1].IsPunct(";") && !t[k + 1].IsPunct("}")
+                && !t[k + 1].IsIdentifier(response))
+            {
+                return IsConstantSpan(f, new Span(k + 1, f.StatementEnd(k + 1)), locals);
             }
 
             return true;
         }
 
+        /// <summary>Checks the first token of a statement, recording <c>const</c>/<c>let</c> locals.</summary>
+        private static bool StatementStartAllowed(Lexed f, Span body, string response, HashSet<string> locals, int k)
+        {
+            var t = f.T;
+            if ((t[k].IsWord("const") || t[k].IsWord("let")) && t[k + 1].IsName)
+            {
+                locals.Add(t[k + 1].Text);
+            }
+
+            if (t[k].IsName && t[k].Text != response && t[k].Text is not ("const" or "let" or "var" or "return" or "if"
+                    or "else" or "await"))
+            {
+                return false;
+            }
+
+            return !(t[k].IsWord("await") && k + 1 < body.End && t[k + 1].IsName && t[k + 1].Text != response);
+        }
