+    private static Site? ShardGroupSite(string file, int line, string template, string totalText,
+        List<(TestInvocation Inv, JsInventory.Selection Sel)> group)
+    {
+        if (!int.TryParse(totalText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var total) || total < 2)
+        {
+            return null;
+        }
+
+        var indices = group.Select(s => int.TryParse(s.Sel.Shard!.Value.Index, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : -1).ToHashSet();
+        if (indices.Contains(-1))
+        {
+            return null;
+        }
+
+        var missing = Enumerable.Range(1, total).Where(n => !indices.Contains(n)).ToList();
+        if (missing.Count == 0)
+        {
+            return null;
+        }
+
+        return new Site(file, line, "Test shard matrix runs only some shards",
+            $"`{Short(template)}` splits the suite into {total} shards, but the matrix runs only "
+            + $"{string.Join(", ", indices.Order())} — shard(s) {string.Join(", ", missing)} never run, so their tests "
+            + "gate nothing. List every shard index in the matrix.");
+    }
