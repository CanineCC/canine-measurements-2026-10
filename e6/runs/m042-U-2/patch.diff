+    private static bool IsCreator(MethodInfo method, ParameterInfo[] parameters, Type document) =>
+        method.Name == "Create" && parameters.Length == 1 && document.IsAssignableFrom(method.ReturnType);
+
+    private static bool TryGetApplyIndexes(ParameterInfo[] parameters, Type document, out int eventIndex, out int documentIndex)
+    {
+        if (document.IsAssignableFrom(parameters[1].ParameterType))
+        {
+            (eventIndex, documentIndex) = (0, 1);
+            return true;
+        }
+
+        if (document.IsAssignableFrom(parameters[0].ParameterType))
