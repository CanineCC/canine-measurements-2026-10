+    private static bool IsOpener(JsToken tok) => tok.IsPunct("(") || tok.IsPunct("{") || tok.IsPunct("[");
+
+    private static bool IsCloser(JsToken tok) => tok.IsPunct(")") || tok.IsPunct("}") || tok.IsPunct("]");
+
+    /// <summary>True when the token at <paramref name="k"/> names a foreign binding, and is not a property access
+    /// (<c>a.name</c>) or an object-literal key (<c>{ name: … }</c>).</summary>
+    private static bool IsForeignReference(IReadOnlyList<JsToken> t, int k, Dictionary<string, Foreign> foreign, out Foreign from)
+    {
+        from = default!;
+        var tok = t[k];
+        if (!tok.IsAnyIdentifier || !foreign.TryGetValue(tok.Text, out var found))
+        {
+            return false;
+        }
+
+        from = found;
+        if (k == 0)
+        {
+            return true;
+        }
+
+        if (t[k - 1].IsMemberAccessor)
+        {
+            return false;
+        }
+
+        var isObjectKey = k + 1 < t.Count && t[k + 1].IsPunct(":") && (t[k - 1].IsPunct("{") || t[k - 1].IsPunct(","));
+        return !isObjectKey;
+    }
+
