+    private static bool IsNestMethodName(Lexed f, int k, int bodyOpen) =>
+        f.T[k].IsName && k + 1 < f.T.Count && f.T[k + 1].IsPunct("(") && f.Depth(k) == f.Depth(bodyOpen) + 1;
+
+    private static Decision NestDecision(bool guarded, bool isPublic, bool global) =>
+        guarded ? Decision.Guarded
+        : isPublic && global ? Decision.Anonymous
+        : global ? Decision.Guarded
+        : Decision.None;
+
+    private static Span NestMethodBody(Lexed f, int k, int bodyOpen)
+    {
+        var paramsClose = f.M[k + 1];
+        var body = Enumerable.Range(paramsClose + 1, Math.Max(0, f.M[bodyOpen] - paramsClose - 1))
+            .FirstOrDefault(x => f.T[x].IsPunct("{"));
+        return body > 0 && f.M[body] > 0 ? new Span(body, f.M[body] + 1) : new Span(k, k + 1);
+    }
+
+    private static IEnumerable<Judged> NestRoutes(Model model, Lexed f, int classIndex, int bodyOpen, List<Decorator> classDecorators)
+    {
+        var t = f.T;
+        var classGuard = classDecorators.Any(d => d.Name == "UseGuards");
+        var classPublic = classDecorators.Any(d => model.IsPublicMarker(f, d.Name));
+        var global = model.AppHasGlobalGuard(f.App);
+        for (var k = bodyOpen + 1; k < f.M[bodyOpen]; k++)
+        {
+            if (!IsNestMethodName(f, k, bodyOpen))
+            {
+                continue;
             }
+
+            var decorators = f.DecoratorsBefore(k);
+            var route = decorators.FirstOrDefault(d => d.Name is not null && NestRouteDecorators.Contains(d.Name));
+            if (route.Name is null)
+            {
+                continue;
+            }
+
+            var bodySpan = NestMethodBody(f, k, bodyOpen);
+            var endpoint = new Endpoint(f.Relative, t[k].Line, $"{t[classIndex + 1].Text}.{t[k].Text}",
+                WritingVerbs.Contains(route.Name), f.App);
+            var isPublic = classPublic || decorators.Any(d => model.IsPublicMarker(f, d.Name));
+            var guarded = classGuard || decorators.Any(d => d.Name == "UseGuards");
+            var decision = NestDecision(guarded, isPublic, global);
+            yield return new Judged(endpoint, decision, model.BodyExempt(f, bodySpan, null), model.BodyChecks(f, bodySpan));
+            k = bodySpan.End - 1;
