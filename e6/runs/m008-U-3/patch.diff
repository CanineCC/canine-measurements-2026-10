+    /// <summary>Whether a candidate focus-state selector styles the element whose outline was removed: the very same
+    /// selector inside the removing rule, otherwise the same element key or a universal selector.</summary>
+    private static bool TargetsRemovedElement(SelectorFacts candidate, SelectorFacts removed, bool isRemovingRule)
+    {
+        if (!candidate.Qualifies || !candidate.FocusState)
+        {
+            return false;
+        }
+
+        return isRemovingRule
+            ? candidate.Raw == removed.Raw
+            : candidate.Key == removed.Key || candidate.Universal;
+    }
+
+    /// <summary>Whether a declaration draws its own indicator, or (in another rule) restores the outline with
+    /// enough precedence to beat the removal.</summary>
+    private static bool ReplacesIndicator(
+        SelectorFacts candidate, Rule rule, Decl d, SelectorFacts removed, Rule removing, Decl removal)
+    {
+        if (DrawsIndicator(d.Property, d.Value))
+        {
+            return true;
+        }
+
+        return !ReferenceEquals(rule, removing)
+               && OutlineEffect(d.Property, d.Value) is false
+               && Outranks(candidate, rule, d, removed, removing, removal);
+    }
