+    /// <summary>Package directory by declared package name, for the non-root packages (first directory wins).</summary>
+    private static Dictionary<string, string> WorkspaceDirsByName(string root, JsInventory.Inventory inv)
+    {
+        var byName = new Dictionary<string, string>(StringComparer.Ordinal);
+        foreach (var dir in inv.Packages.Keys.Where(d => d.Length > 0))
+        {
+            if (CiTestCommands.ReadPackage(root, dir)?.Name is { } n)
+            {
+                byName.TryAdd(n, dir);
+            }
+        }
+
+        return byName;
+    }
+
+    /// <summary>Directories of the workspace packages <paramref name="dir"/> depends on, transitively, in discovery order.</summary>
+    private static List<string> TransitiveWorkspaceDeps(string root, string dir, Dictionary<string, string> byName)
+    {
+        var deps = new List<string>();
+        var queue = new Queue<string>([dir]);
+        while (queue.Count > 0)
+        {
+            foreach (var dep in CiTestCommands.ReadPackage(root, queue.Dequeue())?.Dependencies ?? new HashSet<string>())
+            {
+                if (byName.TryGetValue(dep, out var d) && d != dir && !deps.Contains(d))
+                {
+                    deps.Add(d);
+                    queue.Enqueue(d);
+                }
             }
         }
+
+        return deps;
     }
 
+    private static Site ChangeFilterSite(CiChangeFilter filter, TestInvocation run, string dir, List<string> missedDirs, List<string> missed) =>
+        new(filter.File, filter.Line, "Changed-file filter skips the test gate for code the tests depend on",
+            $"`{filter.Key}` runs `{Short(run.Site.Template)}` (the tests of `{dir}`) only when a change touches "
+            + $"{filter.Patterns}, but those tests also depend on {string.Join(", ", missedDirs.Select(d => $"`{d}`"))} "
+            + $"(e.g. {string.Join(", ", missed.Take(2).Select(f => $"`{f}`"))}) — a change there merges with them not run, "
+            + "and no unfiltered gate runs them. List the package's tests and its workspace dependencies in the filter, "
+            + "or drop it.");
+
