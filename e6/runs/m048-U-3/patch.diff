+    /// <summary>One worktree, brief and shell per taken package; the shells start together and run on.</summary>
+    private async Task<List<ShellJob>> StartShellsAsync(Selection selection, string turnId, string turnDir, string baseSha,
+        string baseWt, List<string> worktrees, CancellationToken ct)
+    {
+        var shells = new List<ShellJob>();
+        var histories = ports.State.LoadShared().Packages;
+        var ledger = Path.Combine(baseWt, LedgerIds.Ledger);
+        var ledgerText = File.Exists(ledger) ? await File.ReadAllTextAsync(ledger, ct).ConfigureAwait(false) : "";
+        foreach (var (p, slot) in selection.Taken.Select((p, i) => (p, i)))
+        {
+            var branch = $"improve/{turnId}/{p.Key.Slug}";
+            var wt = Path.Combine(options.WorktreeRoot, $"{turnId}-{p.Key.Slug}");
+            var dir = Path.Combine(turnDir, p.Key.Slug);
+            Directory.CreateDirectory(dir);
+            await ports.Git.AddWorktreeAsync(wt, branch, baseSha, ct).ConfigureAwait(false);
+            worktrees.Add(wt);
+            var suiteExists = Directory.Exists(Path.Combine(wt, "engine", "tests", "CodeHealth.Tests.Concepts", "suites", p.Key.Concept, p.Key.Language));
+            var brief = Brief.Write(dir, turnId, p, baseSha, branch, Path.Combine(dir, "result.json"), suiteExists,
+                Related(p), Units(p), PreviousAttempt.Of(histories.GetValueOrDefault(p.Key.Slug), options.Host),
+                LedgerIds.Reserve(ledgerText, (options.Instance - 1) * options.MaxPackages + slot), options.Corpus);
+            shells.Add(new ShellJob(p, wt, branch, dir,
+                ports.Shells.RunAsync(new ShellSpec(p.Key, wt, brief, Path.Combine(dir, "shell.log"), options.Timeout), ct)));
+        }
+
+        return shells;
+    }
+
+    /// <summary>Judge one shell once it and the base arm are done.</summary>
+    private async Task<ShellVerdict> JudgeShellAsync(ShellJob s, ShellGate gate, Task<string?> baseArmTask, string baseSha,
+        string baseLabel, string baseWt, CancellationToken ct)
+    {
+        var run = await s.Run.ConfigureAwait(false);
+        var arm = await baseArmTask.ConfigureAwait(false);
+        var input = new ShellGateInput(s.P, s.Wt, s.Branch, baseSha, baseLabel, baseWt, s.Dir, run,
+            ShellReport.Read(Path.Combine(s.Dir, "result.json")));
+        var v = arm is null
+            ? new ShellVerdict(s.P, s.Branch, null, ShellOutcome.Instrument, "the base arm could not be measured",
+                null, null, [], s.P.Items.Select(it => new ItemVerdict(it, false, "base arm unmeasured", [], null)).ToList(), [])
+            : await gate.JudgeAsync(input, ct).ConfigureAwait(false);
+        Say($"  shell {s.P.Key}: {v.Outcome} — {v.Reason} ({v.Figure})");
+        return v;
+    }
