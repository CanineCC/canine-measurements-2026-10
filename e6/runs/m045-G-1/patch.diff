+
+    private static string ShortPin(string s) => s[..Math.Min(10, s.Length)];
+
+    private async Task<TurnCheck?> CheckMergedPinsAsync(IReadOnlyList<ShellVerdict> merged, string? basePin, string headPin, CancellationToken ct)
+    {
+        foreach (var m in merged.Where(m => m.CorpusPin is not null && m.CorpusPin != basePin))
+        {
+            if (!await _corpus.ContainsAsync(headPin, m.CorpusPin!, ct).ConfigureAwait(false))
+            {
+                return new TurnCheck(TurnStage.Bench, $"the merged corpus pin {ShortPin(headPin)} does not contain "
+                    + $"{m.Package.Key}'s pin {ShortPin(m.CorpusPin!)}: the merge lost a bench entry "
+                    + "(tools/bench/merge_pins.py takes the pin that contains the other)", null, Broken: true);
+            }
+        }
+
+        return null;
+    }
+
+    private async Task<TurnCheck?> RunEarlyStagesAsync(string wt, string name, bool all, TurnStage? only, CancellationToken ct)
+    {
+        if (all || only == TurnStage.Prelock)
+        {
+            var log = workspace.FileFor(name, "prelock.log");
+            var step = await gates.RunPrelockAsync(wt, log, ct).ConfigureAwait(false);
+            if (step != StepOutcome.Green)
+            {
+                return StepCheck(TurnStage.Prelock, step, "pre-lock suites", log);
+            }
+        }
+
+        if (all || only == TurnStage.Guards)
+        {
+            var log = workspace.FileFor(name, "guards.log");
+            var step = await gates.RunGuardsAsync(wt, log, ct).ConfigureAwait(false);
+            if (step != StepOutcome.Green)
+            {
+                return StepCheck(TurnStage.Guards, step, "guards", log);
+            }
+        }
+
+        return null;
+    }
+
+    private async Task<BenchArm?> BaseAtPinAsync(string name, BenchArm baseArm, string headPin, List<string> gateLog, CancellationToken ct)
+    {
+        if (_baseAtPin.TryGetValue(headPin, out var atPin))
+        {
+            return atPin;
+        }
+
+        var path = workspace.FileFor(name, $"bench-base-at-{ShortPin(headPin)}.json");
+        var scored = await gates.BenchAtPinAsync(baseArm.Worktree, baseArm.Label, null, headPin, path, ct).ConfigureAwait(false);
+        if (scored is null)
+        {
+            return null;
+        }
+
+        atPin = new BenchArm(baseArm.Worktree, baseArm.Label, null, scored, headPin);
+        _baseAtPin[headPin] = atPin;
+        gateLog.Add($"  bench {name}: base arm scored at the merged corpus pin {ShortPin(headPin)}");
+        return atPin;
+    }
+
+    private async Task<TurnCheck> JudgeSideMovesAsync(string wt, string name, IReadOnlyList<ShellVerdict> merged,
+        Func<ShellVerdict, IReadOnlySet<string>> related, BenchDelta delta, List<string> gateLog, CancellationToken ct)
+    {
         var turnDims = merged.SelectMany(related).ToHashSet(StringComparer.Ordinal);
         var side = await SideMoves.JudgeAsync(gates, index, wt, BenchLines.Of(delta), turnDims,
             Path.GetDirectoryName(workspace.FileFor(name, "bench-delta.json")) ?? wt, ct).ConfigureAwait(false);
