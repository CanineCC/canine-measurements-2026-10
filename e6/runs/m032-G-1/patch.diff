+        private static bool IsSenderCall(Lexed f, int k)
+        {
+            var t = f.T;
+            return t[k].IsName && t[k].Text is "json" or "send" or "end" or "jsonp" && k > 0 && t[k - 1].IsMemberAccessor
+                   && k + 1 < t.Count && t[k + 1].IsPunct("(") && f.M[k + 1] > 0;
+        }
+
+        private static bool StatementIsAllowed(Lexed f, int k, Span body, string response, bool statementStart)
+        {
+            var t = f.T;
+            if (!statementStart)
+            {
+                return true;
+            }
+
+            if (t[k].IsName && t[k].Text != response && t[k].Text is not ("const" or "let" or "var" or "return" or "if"
+                    or "else" or "await"))
+            {
+                return false;
+            }
+
+            return !(t[k].IsWord("await") && k + 1 < body.End && t[k + 1].IsName && t[k + 1].Text != response);
+        }
+
+        private static bool SendPayloadIsConstant(Lexed f, int k, HashSet<string> locals)
+        {
+            return !IsSenderCall(f, k) || IsConstantSpan(f, new Span(k + 2, f.M[k + 1]), locals);
+        }
+
+        private static bool ReturnValueIsConstant(Lexed f, int k, Span body, string response, HashSet<string> locals)
+        {
+            var t = f.T;
+            if (!t[k].IsWord("return") || k + 1 >= body.End || t[k + 1].IsPunct(";") || t[k + 1].IsPunct("}")
+                || t[k + 1].IsIdentifier(response))
+            {
+                return true;
+            }
+
+            return IsConstantSpan(f, new Span(k + 1, f.StatementEnd(k + 1)), locals);
+        }
