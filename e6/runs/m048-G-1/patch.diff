+    private async Task<TurnGateResult> RunTurnGateAsync(List<ShellVerdict> verdicts, string? baseArm, string baseWt, string baseLabel,
+        string turnDir, string turnId, string baseSha, List<string> worktrees, CancellationToken ct)
+    {
+        var passing = verdicts.Where(v => v.Outcome == ShellOutcome.Passed).ToList();
+        var workspace = new TurnWorkspace(ports.Git, options.WorktreeRoot, turnDir, turnId, baseSha, worktrees);
+        var turnGate = new TurnGate(ports.Git, ports.Gates, workspace, ports.Index, ports.Corpus);
+        var result = passing.Count == 0 || baseArm is null
+            ? new TurnGateResult(null, null, [], [], null, ["no branch passed its own gate"])
+            : await turnGate.RunAsync(new BenchArm(baseWt, baseLabel, null, baseArm), passing, v => Related(v.Package).ToHashSet(StringComparer.Ordinal), ct)
+                .ConfigureAwait(false);
+        foreach (var line in result.Log)
+        {
+            Say("  gate: " + line);
+        }
+
+        return result;
+    }
