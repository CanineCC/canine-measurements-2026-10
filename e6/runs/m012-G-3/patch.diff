+    /// <summary>The last token index of the skipped range covering <paramref name="k"/>, or -1 when none does.</summary>
+    private static int SkippedRangeEnd(List<(int From, int To)> skip, ref int s, int k)
+    {
+        while (s < skip.Count && skip[s].To < k)
+        {
+            s++;
+        }
+
+        return s < skip.Count && skip[s].From <= k ? skip[s].To : -1;
+    }
+
+    /// <summary>Adjusts the bracket depth for an opening or closing bracket; false for any other token.</summary>
+    private static bool TrackDepth(JsToken tok, ref int depth)
+    {
+        if (tok.IsPunct("(") || tok.IsPunct("{") || tok.IsPunct("["))
+        {
+            depth++;
+            return true;
+        }
+
+        if (tok.IsPunct(")") || tok.IsPunct("}") || tok.IsPunct("]"))
+        {
+            depth = Math.Max(0, depth - 1);
+            return true;
+        }
+
+        return false;
+    }
+
+    /// <summary>Handles a statement end or declaration head at depth 0; true when the token was consumed.</summary>
+    private static bool TopLevelStep(IReadOnlyList<JsToken> t, ref int k, ref string? declaration)
+    {
+        if (t[k].IsPunct(";"))
+        {
+            declaration = null;
+            return true;
+        }
+
+        if (DeclarationAt(t, k) is { } declared)
+        {
+            declaration = declared.Name;
+            k = declared.NameIndex;
+            return true;
+        }
+
+        return false;
+    }
+
+    private static bool IsForeignReference(IReadOnlyList<JsToken> t, int k, Dictionary<string, Foreign> foreign, out Foreign from)
+    {
+        var tok = t[k];
+        from = default!;
+        if (!tok.IsAnyIdentifier || !foreign.TryGetValue(tok.Text, out var found))
+        {
+            return false;
+        }
+
+        from = found;
+        if (k > 0 && t[k - 1].IsMemberAccessor)
+        {
+            return false;
+        }
+
+        var objectKey = k > 0 && k + 1 < t.Count && t[k + 1].IsPunct(":") && (t[k - 1].IsPunct("{") || t[k - 1].IsPunct(","));
+        return !objectKey;
+    }
+
