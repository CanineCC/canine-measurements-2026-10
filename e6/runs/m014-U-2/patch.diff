+        private static void StartTopLevelSection(ReadState state, string text)
+        {
+            state.Top = Key(text);
+            state.Importer = IsDependencySection(state.Top) ? "." : null;
+            state.Section = state.Importer is null ? null : state.Top;
+            state.Dependency = null;
+            state.PackageKey = null;
+        }
+
+        private static void ReadImportersLine(
+            ReadState state, Dictionary<string, Dictionary<string, string>> importers, int indent, string text)
+        {
+            if (indent == 2)
+            {
+                state.Importer = Key(text);
+                state.Section = null;
+            }
+            else if (indent == 4)
+            {
+                state.Section = Key(text);
+            }
+            else if (state.Importer is not null && IsDependencySection(state.Section))
+            {
+                state.Dependency = Dependency(importers, state.Importer, indent, 6, text, state.Dependency);
+            }
+        }
+
+        private static void ReadPackagesLine(
+            ReadState state, Dictionary<string, LockEntry> packages, int indent, string text, int lineNumber)
+        {
+            if (indent == 2)
+            {
+                var key = Key(text);
+                state.PackageKey = key;
+                if (PackageOf(key) is { } p)
+                {
+                    packages[key] = new LockEntry(p.Name, p.Version, null, lineNumber);
+                }
+            }
+            else if (indent == 4 && state.PackageKey is { } packageKey && text.StartsWith("deprecated:", StringComparison.Ordinal)
+                     && packages.TryGetValue(packageKey, out var entry))
