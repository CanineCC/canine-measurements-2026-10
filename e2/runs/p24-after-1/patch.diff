+
+    /// <summary>A bare name is only evidence when it is unmistakably a FILE (it carries a source extension) and
+    /// exactly one file under the naming module's own tree answers to it.</summary>
+    private static void AddBareNameSubtreeRef(string rootFull, string namingFile, string directory, string fragment, string lastSegment,
+        List<SourceTextRef> sourceTextRefs)
+    {
+        if (FrontendWorkspaceLoader.SourceExtensions.Contains(Path.GetExtension(lastSegment))
+            && FrontendEmittedTemplateRefs.UniqueSubtreeSource(rootFull, directory, fragment) is { } hit)
+        {
+            sourceTextRefs.Add(new SourceTextRef(namingFile, hit, ExactOnly: true));
+        }
+    }
+
+    private static bool IsIterationBoundSourceFragment(IReadOnlySet<string> iterationBoundIdentifiers, string baseName, string lastSegment) =>
+        iterationBoundIdentifiers.Contains(baseName)
+        && FrontendWorkspaceLoader.SourceExtensions.Contains(Path.GetExtension(lastSegment));
