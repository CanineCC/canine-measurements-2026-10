+    /// <summary>The key of the commented-out entry on comment line <paramref name="i"/>, or null when the line is
+    /// not a disabled live-looking entry.</summary>
+    private static string? DisabledEntryKey(YamlLine[] parsed, int i)
+    {
+        var entry = MappingEntry.Match(parsed[i].Text);
+        if (!entry.Success)
+        {
+            return null;
+        }
+
+        var key = entry.Groups["key"].Value;
+        if (TaskTags.Contains(key) || !IsMachineValue(entry.Groups["value"].Value))
+        {
+            return null;
+        }
+
+        if (RunContainsProse(parsed, i) || !HasAlignedLiveSibling(parsed, i) || IsAlsoSetLive(parsed, i, key))
+        {
+            return null;
+        }
+
+        return key;
+    }
