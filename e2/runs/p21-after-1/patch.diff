+
+    // Appends the regex for the `*` at index i and returns the index of the last glob character consumed.
+    private static int AppendStar(System.Text.StringBuilder sb, string glob, int i)
+    {
+        if (i + 1 >= glob.Length || glob[i + 1] != '*')
+        {
+            sb.Append("[^/]*");
+            return i;
+        }
+
+        // `**/` spans zero or more directories; a trailing `**` spans the rest of the path.
+        if (i + 2 < glob.Length && glob[i + 2] == '/')
+        {
+            sb.Append("(?:[^/]*/)*");
+            return i + 2;
+        }
+
+        sb.Append(".*");
+        return i + 1;
+    }
