     /// first-party manifest count, so it never truncates a genuine tree.</summary>
     private const int EnumerationCeiling = 4096;
 
+    /// <summary>The directory to walk for <paramref name="targetPath"/> (its parent when it names a file), or
+    /// <c>null</c> when there is nothing readable to walk.</summary>
+    private static string? ResolveRoot(string? targetPath)
+    {
+        if (string.IsNullOrWhiteSpace(targetPath))
+        {
+            return null;
+        }
+
+        var root = File.Exists(targetPath) ? Path.GetDirectoryName(targetPath) : targetPath;
+        return string.IsNullOrWhiteSpace(root) || !Directory.Exists(root) ? null : root;
+    }
+
+    private static bool IsFirstPartySource(string file, string root)
+    {
+        var ext = Path.GetExtension(file);
+        if (!Array.Exists(SourceExtensions, e => e.Equals(ext, StringComparison.OrdinalIgnoreCase)))
+        {
+            return false;
+        }
+
+        var name = Path.GetFileName(file);
+        var generated = SourceClassifier.IsAmbientTypeScriptDeclaration(name) // .d.ts/.d.cts/.d.mts
+                        || name.EndsWith(".min.js", StringComparison.OrdinalIgnoreCase)
+                        || name.EndsWith(".bundle.js", StringComparison.OrdinalIgnoreCase);
+        return !generated && !IsSkipped(file, root);
+    }
+
     private static bool IsSkipped(string file, string root) => IsSkipped(file, root, SkipDirs);
 
