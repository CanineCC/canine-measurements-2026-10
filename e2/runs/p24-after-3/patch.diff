+    {
+        if (iterationBoundIdentifiers.Contains(baseName)
+            && FrontendWorkspaceLoader.SourceExtensions.Contains(Path.GetExtension(lastSegment)))
+        {
+            sourceTextRefs.Add(new SourceTextRef(namingFile, fragment, AllSuffixMatches: true));
