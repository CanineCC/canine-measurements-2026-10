+    private static void AddBareNameRef(string rootFull, string namingFile, string directory, string fragment, string lastSegment, List<SourceTextRef> sourceTextRefs)
+    {
+        if (FrontendWorkspaceLoader.SourceExtensions.Contains(Path.GetExtension(lastSegment))
+            && FrontendEmittedTemplateRefs.UniqueSubtreeSource(rootFull, directory, fragment) is { } hit)
+        {
+            sourceTextRefs.Add(new SourceTextRef(namingFile, hit, ExactOnly: true));
+        }
+    }
+
+    private static void AddIterationBoundRef(string baseName, string namingFile, string fragment, string lastSegment, List<SourceTextRef> sourceTextRefs,
