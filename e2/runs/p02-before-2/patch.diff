+    /// <summary>Consumes one character inside a quote: a backslash skips the next character, the closing quote ends
+    /// the quote. Returns the quote state after the character.</summary>
+    private static char ContinueQuote(char c, char quote, ref int i)
+    {
+        if (c == '\\')
+        {
+            i++;
+            return quote;
+        }
+
+        return c == quote ? '\0' : quote;
+    }
+
+    /// <summary>`#!` — an interpreter directive, not authored prose.</summary>
+    private static bool IsShebang(ReadOnlySpan<char> line, int i, string prefix) =>
+        prefix == "#" && i + 1 < line.Length && line[i + 1] == '!';
