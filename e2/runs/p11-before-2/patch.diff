+    /// <summary>Highest lock wins per package — see the remarks.</summary>
+    private static async Task<Dictionary<string, string>> ReadHighestLockedVersionsAsync(
+        List<string> lockfiles,
+        CancellationToken cancellationToken)
+    {
+        var locked = new Dictionary<string, string>(StringComparer.Ordinal);
+        foreach (var file in lockfiles)
+        {
+            string json;
+#pragma warning disable CHA0004 // An unreadable lockfile is one we do not grade; the arm's own abstention
+            // covers it and there is nothing for an operator to act on. Failing the scan over one file would
+            // be worse than reading the rest.
+            try
+            {
+                json = await File.ReadAllTextAsync(file, cancellationToken).ConfigureAwait(false);
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            {
+                continue;
+            }
+#pragma warning restore CHA0004
+
+            foreach (var package in NpmLockfileReader.ReadPackageLock(json))
+            {
+                if (!locked.TryGetValue(package.Name, out var existing)
+                    || NpmVersion.IsNewer(package.Version, existing))
+                {
+                    locked[package.Name] = package.Version;
+                }
+            }
+        }
+
+        return locked;
+    }
+
