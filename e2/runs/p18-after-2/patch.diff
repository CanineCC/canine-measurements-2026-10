+    /// <summary>The indexes of the <c>[</c> and matching <c>]</c> of the array literal written for argument label
+    /// <paramref name="label"/>, or <c>null</c> when the label is absent, its value is not an array literal, or the
+    /// array is only the first term of a larger expression.</summary>
+    private static (int Open, int Close)? WholeArrayArgumentBounds(string call, string label)
+    {
+        var at = IndexOfLabelAtTopLevel(call, label);
+        if (at < 0)
+        {
+            return null;
+        }
+
+        var open = SkipWhitespace(call, at);
+        if (open >= call.Length || call[open] != '[')
+        {
+            return null;
+        }
+
+        var close = MatchingBracket(call, open, '[', ']');
+        if (close < 0)
+        {
+            return null;
+        }
+
+        // ★ AN ARRAY LITERAL THAT IS ONLY THE FIRST TERM OF AN EXPRESSION IS NOT THE VALUE.
+        // `targets: ["Core"] + extraTargets` writes a readable array and then adds a computed one to it; reading the
+        // bracket alone would publish the half the author wrote down and silently drop the half they computed, which
+        // is the same half-read this method's all-or-nothing rule refuses one level down. The argument ends at a
+        // comma or at the end of the call; anything else is an operator.
+        var after = SkipWhitespace(call, close + 1);
+        if (after < call.Length && call[after] != ',')
+        {
+            return null;
+        }
+
+        return (open, close);
+    }
