+    private static List<JsonElement> RootItems(JsonElement root) =>
+        root.ValueKind == JsonValueKind.Array
+            ? root.EnumerateArray().ToList()
+            : root.ValueKind == JsonValueKind.Object ? [root] : [];
+
+    private static ObservedContainer ToContainer(JsonElement item)
+    {
+        var config = Obj(item, "Config");
+        var host = Obj(item, "HostConfig");
+        var securityOpt = Strings(host, "SecurityOpt");
+
+        return new ObservedContainer(
+            Str(item, "Name").TrimStart('/'),
+            config is null ? "" : Str(config.Value, "Image"),
+            config is null ? "" : Str(config.Value, "User"),
+            host is not null && Bool(host.Value, "Privileged"),
+            Strings(host, "CapAdd"),
+            Strings(host, "CapDrop"),
+            host is not null && Bool(host.Value, "ReadonlyRootfs"),
+            config is not null && config.Value.TryGetProperty("Healthcheck", out var hc) && hc.ValueKind == JsonValueKind.Object,
+            securityOpt.Any(o =>
+                o.Contains("no-new-privileges", StringComparison.OrdinalIgnoreCase)
+                && !string.Equals(o, DockerAddedLabelDisable, StringComparison.OrdinalIgnoreCase)));
+    }
+
     private static JsonElement? Obj(JsonElement parent, string name) =>
         parent.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Object ? v : null;
 
