+    /// <summary>The quote state after <paramref name="c"/> while inside a quote; a backslash skips the next char.</summary>
+    private static char QuoteAfter(char c, char quote, ref int i)
+    {
+        if (c == '\\')
+        {
+            i++;
+            return quote;
+        }
+
+        return c == quote ? '\0' : quote;
+    }
+
+    /// <summary>`#!` — an interpreter directive, not authored prose.</summary>
+    private static bool IsInterpreterDirective(ReadOnlySpan<char> line, int i, string prefix) =>
+        prefix == "#" && i + 1 < line.Length && line[i + 1] == '!';
