+    /// <summary>The production package a <c>packages</c> entry denotes, or null when it is not one.</summary>
+    private static NpmLockedPackage? ProductionPackage(JsonProperty entry)
+    {
+        // "" is the root project itself, not a dependency of anything.
+        // dev: not shipped. link: a directory in this repo, with no published release to be behind.
+        if (entry.Name.Length == 0
+            || entry.Value.ValueKind != JsonValueKind.Object
+            || IsTrue(entry.Value, "dev")
+            || IsTrue(entry.Value, "link"))
+        {
+            return null;
+        }
+
+        var name = PackageNameFromKey(entry.Name);
+        return name.Length > 0 && VersionOf(entry.Value) is { } text
+            ? new NpmLockedPackage(name, text)
+            : null;
+    }
