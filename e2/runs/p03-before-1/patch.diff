+    /// <summary>The key of the commented-out entry on line <paramref name="i"/> when it is convicted as disabled
+    /// configuration, otherwise null.</summary>
+    private static string? ConvictedEntryKey(YamlLine[] parsed, int i, IReadOnlyList<DisabledBlock> blocks)
+    {
+        if (parsed[i].Kind != LineKind.Comment)
+        {
+            return null;
+        }
+
+        // A line inside a convicted block is already billed by the block row above. Reporting it again is the
+        // "one defect, two rows" trap D17 is repeatedly fixed for.
+        if (blocks.Any(b => i >= b.Start && i <= b.End))
+        {
+            return null;
+        }
+
+        var entry = MappingEntry.Match(parsed[i].Text);
+        if (!entry.Success)
+        {
+            return null;
+        }
+
+        var key = entry.Groups["key"].Value;
+        if (TaskTags.Contains(key) || !IsMachineValue(entry.Groups["value"].Value))
+        {
+            return null;
+        }
+
+        if (RunContainsProse(parsed, i) || !HasAlignedLiveSibling(parsed, i) || IsAlsoSetLive(parsed, i, key))
+        {
+            return null;
+        }
+
+        return key;
+    }
