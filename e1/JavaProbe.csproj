<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine's Java code model (its own sidecar) and its own D1/D2 complexity calculator, over one source tree,
       printing every method. Build against ONE pinned engine: -p:EngineSrc=<worktree>/engine/src -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EngineSrc)/CodeHealth.CodeModel.Sidecars/CodeHealth.CodeModel.Sidecars.csproj" />
    <ProjectReference Include="$(EngineSrc)/Core/Complexity/CodeHealth.Core.Complexity.csproj" />
  </ItemGroup>
</Project>
